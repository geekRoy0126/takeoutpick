+import { dealStatus, type DealStatus } from "@/lib/domain/deals";
+
+const STATUS_UI: Record<DealStatus, { label: string; icon: string; className: string }> = {
+  ACTIVE: { label: "Active", icon: "✓", className: "bg-deal-active text-white" },
+  EXPIRING_SOON: { label: "Expiring soon", icon: "⏳", className: "bg-deal-soon text-white" },
+  EXPIRED: { label: "Expired", icon: "✕", className: "bg-deal-expired text-white opacity-70" },
+};
+
+export interface DealBadgeProps {
+  expiresAt: Date | string;
+  source: "OFFICIAL" | "COMMUNITY";
+  /** Injected for tests; defaults to the current time. */
+  now?: Date;
+}
+
+/** Status pill (text + icon + color, never color alone) with an Official / Community tag beside it. */
+export function DealBadge({ expiresAt, source, now }: DealBadgeProps) {
+  const status = dealStatus(expiresAt, now);
+  const ui = STATUS_UI[status];
+  return (
+    <span className="inline-flex items-center gap-1.5 text-xs font-medium">
+      <span
+        data-status={status}
+        className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 ${ui.className}`}
+      >
+        <span aria-hidden="true">{ui.icon}</span>
+        <span>{ui.label}</span>
+      </span>
+      <span className="rounded-full border border-line bg-surface-muted px-2 py-0.5 text-ink-muted">
+        {source === "OFFICIAL" ? "Official" : "Community"}
+      </span>
+    </span>
+  );
+}

@@ -0,0 +1,132 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  applyDeal,
+  dealDiscountCents,
+  dealStatus,
+  EXPIRING_SOON_MS,
+  isDealUsable,
+  type DealTerms,
+} from "./deals";
+
+const NOW = new Date("2026-11-01T12:00:00Z");
+const HOUR = 60 * 60 * 1000;
+const at = (offsetMs: number) => new Date(NOW.getTime() + offsetMs);
+
+const percent20: DealTerms = { kind: "PERCENT_OFF", percentOff: 20, amountOffCents: null, minOrderCents: 0 };
+const fiveOffMin20: DealTerms = { kind: "AMOUNT_OFF", percentOff: null, amountOffCents: 500, minOrderCents: 2000 };
+
+describe("dealStatus", () => {
+  it("is EXPIRED when now equals expiresAt", () => {
+    expect(dealStatus(NOW, NOW)).toBe("EXPIRED");
+  });
+
+  it("is EXPIRED when expiresAt is in the past", () => {
+    expect(dealStatus(at(-1), NOW)).toBe("EXPIRED");
+  });
+
+  it("is EXPIRING_SOON at exactly 72 hours left", () => {
+    expect(EXPIRING_SOON_MS).toBe(72 * HOUR);
+    expect(dealStatus(at(72 * HOUR), NOW)).toBe("EXPIRING_SOON");
+  });
+
+  it("is EXPIRING_SOON with 1 ms left", () => {
+    expect(dealStatus(at(1), NOW)).toBe("EXPIRING_SOON");
+  });
+
+  it("is ACTIVE with more than 72 hours left", () => {
+    expect(dealStatus(at(72 * HOUR + 1), NOW)).toBe("ACTIVE");
+  });
+
+  it("accepts ISO strings (API payloads)", () => {
+    expect(dealStatus(at(100 * HOUR).toISOString(), NOW)).toBe("ACTIVE");
+  });
+
+  it("defaults now to the current time", () => {
+    expect(dealStatus(new Date(Date.now() + 100 * HOUR))).toBe("ACTIVE");
+    expect(dealStatus(new Date(Date.now() - 1))).toBe("EXPIRED");
+  });
+});
+
+describe("dealDiscountCents", () => {
+  it("rounds percent-off to the nearest cent", () => {
+    // 20% of $10.99 = 219.8 -> 220
+    expect(dealDiscountCents(percent20, 1099)).toBe(220);
+  });
+
+  it("returns the fixed amount for amount-off", () => {
+    expect(dealDiscountCents(fiveOffMin20, 2500)).toBe(500);
+  });
+
+  it("never discounts more than the subtotal", () => {
+    expect(dealDiscountCents({ ...fiveOffMin20, minOrderCents: 0 }, 300)).toBe(300);
+    expect(dealDiscountCents({ ...percent20, percentOff: 150 }, 1000)).toBe(1000);
+  });
+
+  it("returns 0 when the deal amount is missing", () => {
+    expect(dealDiscountCents({ ...percent20, percentOff: null }, 1000)).toBe(0);
+    expect(dealDiscountCents({ ...fiveOffMin20, amountOffCents: null }, 3000)).toBe(0);
+  });
+
+  it("rejects non-integer cents", () => {
+    expect(() => dealDiscountCents(percent20, 10.5)).toThrow(TypeError);
+  });
+});
+
+describe("isDealUsable", () => {
+  it("is false for hidden or expired deals", () => {
+    expect(isDealUsable({ hidden: true, expiresAt: at(100 * HOUR) }, NOW)).toBe(false);
+    expect(isDealUsable({ hidden: false, expiresAt: NOW }, NOW)).toBe(false);
+  });
+
+  it("is true for visible active or expiring-soon deals", () => {
+    expect(isDealUsable({ hidden: false, expiresAt: at(HOUR) }, NOW)).toBe(true);
+    expect(isDealUsable({ hidden: false, expiresAt: at(100 * HOUR) }, NOW)).toBe(true);
+  });
+});
+
+describe("applyDeal", () => {
+  const live = { hidden: false, expiresAt: at(100 * HOUR) };
+
+  it("applies the discount when the subtotal meets the minimum", () => {
+    expect(applyDeal({ ...fiveOffMin20, ...live }, 2000, NOW)).toEqual({
+      status: "ACTIVE",
+      applied: true,
+      discountCents: 500,
+      beforeCents: 2000,
+      afterCents: 1500,
+      shortfallCents: 0,
+    });
+  });
+
+  it("does not apply below the minimum and reports how much more is needed", () => {
+    expect(applyDeal({ ...fiveOffMin20, ...live }, 1350, NOW)).toEqual({
+      status: "ACTIVE",
+      applied: false,
+      discountCents: 0,
+      beforeCents: 1350,
+      afterCents: 1350,
+      shortfallCents: 650,
+    });
+  });
+
+  it("never applies an expired deal, even above the minimum, and shows no hint", () => {
+    const result = applyDeal({ ...fiveOffMin20, hidden: false, expiresAt: at(-HOUR) }, 1000, NOW);
+    expect(result).toMatchObject({ status: "EXPIRED", applied: false, discountCents: 0, afterCents: 1000, shortfallCents: 0 });
+  });
+
+  it("never applies a hidden deal", () => {
+    const result = applyDeal({ ...percent20, hidden: true, expiresAt: at(100 * HOUR) }, 1000, NOW);
+    expect(result).toMatchObject({ applied: false, discountCents: 0, afterCents: 1000, shortfallCents: 0 });
+  });
+
+  it("applies an expiring-soon deal", () => {
+    const result = applyDeal({ ...percent20, hidden: false, expiresAt: at(HOUR) }, 1000, NOW);
+    expect(result).toMatchObject({ status: "EXPIRING_SOON", applied: true, discountCents: 200, afterCents: 800 });
+  });
+
+  it("treats a missing hidden flag as visible", () => {
+    const result = applyDeal({ ...percent20, expiresAt: at(100 * HOUR) }, 1000, NOW);
+    expect(result.applied).toBe(true);
+  });
+});
diff --git a/src/lib/domain/deals.ts b/src/lib/domain/deals.ts
new file mode 100644
index 0000000..825f461
--- /dev/null
+++ b/src/lib/domain/deals.ts
@@ -0,0 +1,73 @@
+// Deal rules from docs/PRD.md Section 4. Status is always computed from the current time and never stored.
+import { percentOf } from "./money";
+
+export type DealStatus = "ACTIVE" | "EXPIRING_SOON" | "EXPIRED";
+
+/** A deal is "expiring soon" when 72 hours or less remain. */
+export const EXPIRING_SOON_MS = 72 * 60 * 60 * 1000;
+
+export interface DealTerms {
+  kind: "PERCENT_OFF" | "AMOUNT_OFF";
+  percentOff: number | null;
+  amountOffCents: number | null;
+  minOrderCents: number;
+}
+
+export interface DealTiming {
+  expiresAt: Date | string;
+  hidden?: boolean;
+}
+
+export type ApplicableDeal = DealTerms & DealTiming;
+
+export interface DealApplication {
+  status: DealStatus;
+  /** True only when the deal is visible, not expired and the subtotal meets the minimum. */
+  applied: boolean;
+  discountCents: number;
+  beforeCents: number;
+  afterCents: number;
+  /** Cents still needed to reach the minimum; 0 when met or when the deal can't be used anyway. */
+  shortfallCents: number;
+}
+
+export function dealStatus(expiresAt: Date | string, now: Date = new Date()): DealStatus {
+  const remaining = new Date(expiresAt).getTime() - now.getTime();
+  if (remaining <= 0) return "EXPIRED";
+  if (remaining <= EXPIRING_SOON_MS) return "EXPIRING_SOON";
+  return "ACTIVE";
+}
+
+/** Non-hidden and not expired. */
+export function isDealUsable(deal: DealTiming, now: Date = new Date()): boolean {
+  return !deal.hidden && dealStatus(deal.expiresAt, now) !== "EXPIRED";
+}
+
+/** Discount on the subtotal, ignoring the minimum and expiry. Never more than the subtotal. */
+export function dealDiscountCents(deal: DealTerms, subtotalCents: number): number {
+  assertCents(subtotalCents);
+  const raw =
+    deal.kind === "PERCENT_OFF" ? percentOf(subtotalCents, deal.percentOff ?? 0) : (deal.amountOffCents ?? 0);
+  return Math.min(Math.max(raw, 0), subtotalCents);
+}
+
+/** Applies a deal to a subtotal: the discount only counts if the deal is usable and the minimum is met. */
+export function applyDeal(deal: ApplicableDeal, subtotalCents: number, now: Date = new Date()): DealApplication {
+  const status = dealStatus(deal.expiresAt, now);
+  const usable = isDealUsable(deal, now);
+  const meetsMinimum = subtotalCents >= deal.minOrderCents;
+  const applied = usable && meetsMinimum;
+  const discountCents = applied ? dealDiscountCents(deal, subtotalCents) : 0;
+  return {
+    status,
+    applied,
+    discountCents,
+    beforeCents: subtotalCents,
+    afterCents: subtotalCents - discountCents,
+    shortfallCents: usable && !meetsMinimum ? deal.minOrderCents - subtotalCents : 0,
+  };
+}
+
+function assertCents(cents: number): void {
+  if (!Number.isInteger(cents)) throw new TypeError(`Expected integer cents, got ${cents}`);
+}

+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import { DealBadge } from "./DealBadge";
+import { MinOrderHint } from "./MinOrderHint";
+import { PriceWithDeal } from "./PriceWithDeal";
+
+const NOW = new Date("2026-11-01T12:00:00Z");
+const HOUR = 60 * 60 * 1000;
+const at = (offsetMs: number) => new Date(NOW.getTime() + offsetMs);
+
+const fiveOffMin20 = {
+  kind: "AMOUNT_OFF" as const,
+  percentOff: null,
+  amountOffCents: 500,
+  minOrderCents: 2000,
+  hidden: false,
+  expiresAt: at(100 * HOUR),
+};
+
+describe("DealBadge", () => {
+  it.each([
+    [at(100 * HOUR), "Active", "bg-deal-active"],
+    [at(10 * HOUR), "Expiring soon", "bg-deal-soon"],
+    [at(-HOUR), "Expired", "bg-deal-expired"],
+  ])("shows a text label and status color for expiresAt %s", (expiresAt, label, colorClass) => {
+    render(<DealBadge expiresAt={expiresAt} source="OFFICIAL" now={NOW} />);
+    const badge = screen.getByText(label).closest("[data-status]");
+    expect(badge).toHaveClass(colorClass);
+  });
+
+  it("labels official and community deals differently", () => {
+    const { rerender } = render(<DealBadge expiresAt={at(100 * HOUR)} source="OFFICIAL" now={NOW} />);
+    expect(screen.getByText("Official")).toBeInTheDocument();
+    expect(screen.queryByText("Community")).not.toBeInTheDocument();
+
+    rerender(<DealBadge expiresAt={at(100 * HOUR)} source="COMMUNITY" now={NOW} />);
+    expect(screen.getByText("Community")).toBeInTheDocument();
+    expect(screen.queryByText("Official")).not.toBeInTheDocument();
+  });
+});
+
+describe("MinOrderHint", () => {
+  it("tells the diner how much more to add, politely announced", () => {
+    render(<MinOrderHint shortfallCents={650} />);
+    const hint = screen.getByText("Add $6.50 more to use this deal");
+    expect(hint.closest("[aria-live]")).toHaveAttribute("aria-live", "polite");
+    expect(hint).toHaveClass("text-deal-soon");
+  });
+
+  it("keeps the live region but renders no text when there is no shortfall", () => {
+    const { container } = render(<MinOrderHint shortfallCents={0} />);
+    expect(container.querySelector("[aria-live='polite']")).toBeInTheDocument();
+    expect(screen.queryByText(/more to use this deal/)).not.toBeInTheDocument();
+  });
+});
+
+describe("PriceWithDeal", () => {
+  it("shows the price before (struck through) and after the deal", () => {
+    render(<PriceWithDeal subtotalCents={2500} deal={fiveOffMin20} now={NOW} />);
+    const before = screen.getByText("$25.00");
+    expect(before.tagName).toBe("S");
+    expect(screen.getByText("$20.00")).toHaveClass("font-bold");
+    expect(screen.queryByText(/more to use this deal/)).not.toBeInTheDocument();
+  });
+
+  it("below the minimum: no discount and the min-order hint", () => {
+    render(<PriceWithDeal subtotalCents={1350} deal={fiveOffMin20} now={NOW} />);
+    expect(screen.getByText("$13.50")).toHaveClass("font-bold");
+    expect(document.querySelector("s")).toBeNull();
+    expect(screen.getByText("Add $6.50 more to use this deal")).toBeInTheDocument();
+  });
+
+  it("expired deal: plain price, no hint", () => {
+    render(<PriceWithDeal subtotalCents={1000} deal={{ ...fiveOffMin20, expiresAt: at(-HOUR) }} now={NOW} />);
+    expect(screen.getByText("$10.00")).toBeInTheDocument();
+    expect(document.querySelector("s")).toBeNull();
+    expect(screen.queryByText(/more to use this deal/)).not.toBeInTheDocument();
+  });
+
+  it("no deal: plain price", () => {
+    render(<PriceWithDeal subtotalCents={1000} deal={null} now={NOW} />);
+    expect(screen.getByText("$10.00")).toBeInTheDocument();
+    expect(document.querySelector("s")).toBeNull();
+  });
+
+  it("updates the hint live when the subtotal changes", () => {
+    const { rerender } = render(<PriceWithDeal subtotalCents={1000} deal={fiveOffMin20} now={NOW} />);
+    expect(screen.getByText("Add $10.00 more to use this deal")).toBeInTheDocument();
+    rerender(<PriceWithDeal subtotalCents={2000} deal={fiveOffMin20} now={NOW} />);
+    expect(screen.queryByText(/more to use this deal/)).not.toBeInTheDocument();
+    expect(screen.getByText("$15.00")).toBeInTheDocument();
+  });
+});
diff --git a/src/lib/domain/deals.test.ts b/src/lib/domain/deals.test.ts

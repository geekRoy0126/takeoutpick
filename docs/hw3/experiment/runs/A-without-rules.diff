+import { applyDeal, type ApplicableDeal } from "@/lib/domain/deals";
+import { formatCents } from "@/lib/domain/money";
+
+import { MinOrderHint } from "./MinOrderHint";
+
+export interface PriceWithDealProps {
+  subtotalCents: number;
+  deal: ApplicableDeal | null;
+  /** Injected for tests; defaults to the current time. */
+  now?: Date;
+}
+
+/** Struck-through price before the deal and bold price after; below the minimum, no discount plus a hint. */
+export function PriceWithDeal({ subtotalCents, deal, now }: PriceWithDealProps) {
+  const result = deal ? applyDeal(deal, subtotalCents, now) : null;
+  const applied = result?.applied ?? false;
+  const after = result?.afterCents ?? subtotalCents;
+
+  return (
+    <div className="flex flex-col gap-0.5">
+      <p className="flex items-baseline gap-2">
+        {applied ? (
+          <>
+            <span className="sr-only">Was</span>
+            <s className="text-sm text-ink-muted">{formatCents(subtotalCents)}</s>
+            <span className="sr-only">now</span>
+          </>
+        ) : null}
+        <span className="font-bold">{formatCents(after)}</span>
+      </p>
+      {deal ? <MinOrderHint shortfallCents={result?.shortfallCents ?? 0} /> : null}
+    </div>
+  );
+}

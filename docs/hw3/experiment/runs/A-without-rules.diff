@@ -0,0 +1,81 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const findMany = vi.fn();
+vi.mock("@/lib/server/db", () => ({ db: { deal: { findMany } } }));
+
+const { GET } = await import("./route");
+
+const NOW = new Date("2026-11-01T12:00:00Z");
+
+function get(query = "") {
+  return GET(new Request(`http://localhost/api/v1/deals${query}`));
+}
+
+const row = {
+  id: "d1",
+  restaurantId: "r1",
+  createdById: "u1",
+  title: "$5 off $20",
+  kind: "AMOUNT_OFF",
+  percentOff: null,
+  amountOffCents: 500,
+  minOrderCents: 2000,
+  expiresAt: new Date("2026-11-02T12:00:00Z"),
+  source: "OFFICIAL",
+  hidden: false,
+  createdAt: NOW,
+  updatedAt: NOW,
+};
+
+describe("GET /api/v1/deals", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(NOW);
+    findMany.mockReset().mockResolvedValue([row]);
+  });
+
+  it("status=active asks for non-hidden, non-expired deals, soonest expiry first", async () => {
+    const res = await get("?status=active");
+    expect(res.status).toBe(200);
+    expect(findMany).toHaveBeenCalledWith(
+      expect.objectContaining({
+        where: { hidden: false, expiresAt: { gt: NOW } },
+        orderBy: { expiresAt: "asc" },
+      }),
+    );
+  });
+
+  it("returns each deal with its computed status and without internal fields", async () => {
+    const body = await (await get("?status=active")).json();
+    expect(body.data).toHaveLength(1);
+    expect(body.data[0]).toMatchObject({ id: "d1", status: "EXPIRING_SOON", expiresAt: "2026-11-02T12:00:00.000Z" });
+    expect(body.data[0]).not.toHaveProperty("hidden");
+    expect(body.data[0]).not.toHaveProperty("createdById");
+  });
+
+  it("without a status filter still excludes hidden deals", async () => {
+    await get();
+    expect(findMany).toHaveBeenCalledWith(expect.objectContaining({ where: { hidden: false } }));
+  });
+
+  it("status=expired asks for past deals only", async () => {
+    await get("?status=expired");
+    expect(findMany).toHaveBeenCalledWith(expect.objectContaining({ where: { hidden: false, expiresAt: { lte: NOW } } }));
+  });
+
+  it("rejects an unknown status with the error envelope", async () => {
+    const res = await get("?status=bogus");
+    expect(res.status).toBe(422);
+    const body = await res.json();
+    expect(body.error.code).toBe("VALIDATION_FAILED");
+    expect(findMany).not.toHaveBeenCalled();
+  });
+
+  it("hides database errors behind a generic 500", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    findMany.mockRejectedValueOnce(new Error("connection refused"));
+    const res = await get("?status=active");
+    expect(res.status).toBe(500);
+    expect((await res.json()).error.message).toBe("Something went wrong.");
+  });
+});
diff --git a/src/app/api/v1/deals/route.ts b/src/app/api/v1/deals/route.ts
new file mode 100644
index 0000000..11a7db6
--- /dev/null
+++ b/src/app/api/v1/deals/route.ts
@@ -0,0 +1,59 @@
+// GET /api/v1/deals — public list of deals with their computed status (docs/PRD.md US3, US10).
+// ?status=active returns only non-hidden, non-expired deals, soonest expiry first. Hidden deals are never returned.
+import { z } from "zod";
+
+import { ok, parseOrThrow, toErrorResponse } from "@/lib/api/http";
+import { dealStatus } from "@/lib/domain/deals";
+import { db } from "@/lib/server/db";
+
+const querySchema = z.object({
+  status: z.enum(["active", "expired"]).optional(),
+  restaurantId: z.string().min(1).optional(),
+});
+
+export async function GET(request: Request): Promise<Response> {
+  try {
+    const params = Object.fromEntries(new URL(request.url).searchParams);
+    const { status, restaurantId } = parseOrThrow(querySchema, params);
+    const now = new Date();
+
+    const deals = await db.deal.findMany({
+      where: {
+        hidden: false,
+        ...(restaurantId ? { restaurantId } : {}),
+        ...(status === "active" ? { expiresAt: { gt: now } } : {}),
+        ...(status === "expired" ? { expiresAt: { lte: now } } : {}),
+      },
+      orderBy: { expiresAt: "asc" },
+      select: {
+        id: true,
+        restaurantId: true,
+        title: true,
+        kind: true,
+        percentOff: true,
+        amountOffCents: true,
+        minOrderCents: true,
+        expiresAt: true,
+        source: true,
+      },
+    });
+
+    // Map field by field so internal columns (hidden, createdById) can never leak into the public API.
+    return ok(
+      deals.map((d) => ({
+        id: d.id,
+        restaurantId: d.restaurantId,
+        title: d.title,
+        kind: d.kind,
+        percentOff: d.percentOff,
+        amountOffCents: d.amountOffCents,
+        minOrderCents: d.minOrderCents,
+        expiresAt: d.expiresAt,
+        source: d.source,
+        status: dealStatus(d.expiresAt, now),
+      })),
+    );
+  } catch (err) {
+    return toErrorResponse(err);
+  }
+}

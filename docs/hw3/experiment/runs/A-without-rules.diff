+import { formatCents } from "@/lib/domain/money";
+
+export interface MinOrderHintProps {
+  /** Cents still needed to reach the deal minimum; 0 renders nothing (the live region stays mounted). */
+  shortfallCents: number;
+}
+
+/** "Add $X.XX more to use this deal", announced politely when it changes. */
+export function MinOrderHint({ shortfallCents }: MinOrderHintProps) {
+  return (
+    <p aria-live="polite" className="text-sm">
+      {shortfallCents > 0 ? (
+        <span className="text-deal-soon">Add {formatCents(shortfallCents)} more to use this deal</span>
+      ) : null}
+    </p>
+  );
+}

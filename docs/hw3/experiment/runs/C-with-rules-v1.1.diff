@@ -0,0 +1,40 @@
+import { applyDeal, type DealStatus, type DealTerms } from "@/lib/domain/deals";
+import { formatCents } from "@/lib/domain/money";
+
+import { MinOrderHint } from "./min-order-hint";
+
+type PriceWithDealProps = {
+  subtotalCents: number;
+  /** Null when the dish has no deal. Status is computed by the caller from its `now` (AGENTS.md §1.3). */
+  deal: DealTerms | null;
+  status: DealStatus | null;
+};
+
+/** Struck-through price before the deal and bold price after; below the minimum, no discount plus a hint. */
+export function PriceWithDeal({ subtotalCents, deal, status }: PriceWithDealProps) {
+  if (!deal || !status || status === "expired") {
+    return <PlainPrice cents={subtotalCents} />;
+  }
+  const result = applyDeal(subtotalCents, deal, status);
+  return (
+    <div className="flex flex-col gap-1">
+      <div aria-live="polite" className="flex items-baseline gap-2">
+        {result.isApplied ? (
+          <>
+            <span className="sr-only">Price before deal</span>
+            <s className="text-sm text-ink-muted">{formatCents(subtotalCents)}</s>
+            <span className="sr-only">Price after deal</span>
+            <span className="text-lg font-semibold">{formatCents(result.afterCents)}</span>
+          </>
+        ) : (
+          <span className="text-lg font-semibold">{formatCents(subtotalCents)}</span>
+        )}
+      </div>
+      <MinOrderHint shortfallCents={result.shortfallCents} />
+    </div>
+  );
+}
+
+function PlainPrice({ cents }: { cents: number }) {
+  return <span className="text-lg font-semibold">{formatCents(cents)}</span>;
+}

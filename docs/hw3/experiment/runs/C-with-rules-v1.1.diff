+import { formatCents } from "@/lib/domain/money";
+
+type MinOrderHintProps = {
+  shortfallCents: number;
+};
+
+/**
+ * "Add $X.XX more to use this deal". The live region stays mounted even when empty so screen readers
+ * announce the hint when a quantity change makes it appear or disappear.
+ */
+export function MinOrderHint({ shortfallCents }: MinOrderHintProps) {
+  return (
+    <p role="status" aria-live="polite" className="text-sm font-medium text-deal-soon">
+      {shortfallCents > 0 ? `Add ${formatCents(shortfallCents)} more to use this deal` : null}
+    </p>
+  );
+}

+// GET /api/v1/deals and listDeals against a real Postgres (US3, #5).
+// Run: `docker compose up -d db && npx prisma migrate dev && npm run test:int`.
+import { beforeEach, describe, expect, it } from "vitest";
+
+import { GET } from "@/app/api/v1/deals/route";
+import { db } from "@/lib/server/db";
+import { listDeals } from "@/lib/server/services/deal-service";
+
+const NOW = new Date("2026-11-03T12:00:00Z");
+const HOUR_MS = 60 * 60 * 1000;
+const at = (hoursFromNow: number) => new Date(NOW.getTime() + hoursFromNow * HOUR_MS);
+// The route reads the real clock (it owns `now`), so its fixtures are relative to the real time.
+const fromRealNow = (hours: number) => new Date(Date.now() + hours * HOUR_MS);
+
+type Seed = { restaurantId: string; otherRestaurantId: string; userId: string };
+type DealExtra = { hidden?: boolean; restaurantId?: string };
+
+async function seedBase(): Promise<Seed> {
+  const user = await db.user.create({
+    data: { email: "diner@example.com", name: "Diner", passwordHash: "x" },
+  });
+  const restaurant = await db.restaurant.create({ data: { name: "Pho Place", cuisine: "Vietnamese" } });
+  const other = await db.restaurant.create({ data: { name: "Taco Spot", cuisine: "Mexican" } });
+  return { restaurantId: restaurant.id, otherRestaurantId: other.id, userId: user.id };
+}
+
+async function createDeal(seed: Seed, title: string, expiresAt: Date, extra: DealExtra = {}) {
+  return db.deal.create({
+    data: {
+      title,
+      kind: "PERCENT_OFF",
+      percentOff: 10,
+      minOrderCents: 2000,
+      expiresAt,
+      source: "OFFICIAL",
+      restaurantId: extra.restaurantId ?? seed.restaurantId,
+      createdById: seed.userId,
+      hidden: extra.hidden ?? false,
+    },
+  });
+}
+
+beforeEach(async () => {
+  await db.deal.deleteMany();
+  await db.restaurant.deleteMany();
+  await db.user.deleteMany();
+});
+
+describe("listDeals", () => {
+  it("returns only non-hidden, non-expired deals, soonest expiry first, for status=active", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Later", at(200));
+    await createDeal(seed, "Soon", at(10));
+    await createDeal(seed, "Expired", at(-1));
+    await createDeal(seed, "Exactly now", NOW);
+    await createDeal(seed, "Hidden", at(5), { hidden: true });
+
+    const deals = await listDeals({ status: "active", now: NOW });
+
+    expect(deals.map((d) => d.title)).toEqual(["Soon", "Later"]);
+    expect(deals.map((d) => d.status)).toEqual(["expiring_soon", "active"]);
+  });
+
+  it("never returns hidden deals, even without a status filter", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Visible expired", at(-5));
+    await createDeal(seed, "Hidden", at(5), { hidden: true });
+
+    const deals = await listDeals({ now: NOW });
+
+    expect(deals.map((d) => d.title)).toEqual(["Visible expired"]);
+    expect(deals[0]?.status).toBe("expired");
+  });
+
+  it("returns only expired deals for status=expired", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Expired", at(-5));
+    await createDeal(seed, "Active", at(100));
+
+    const deals = await listDeals({ status: "expired", now: NOW });
+
+    expect(deals.map((d) => d.title)).toEqual(["Expired"]);
+  });
+
+  it("filters by restaurantId", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Mine", at(100));
+    await createDeal(seed, "Theirs", at(100), { restaurantId: seed.otherRestaurantId });
+
+    const deals = await listDeals({ status: "active", restaurantId: seed.restaurantId, now: NOW });
+
+    expect(deals.map((d) => d.title)).toEqual(["Mine"]);
+  });
+
+  it("returns a DTO with ISO dates and no internal fields", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Soon", at(10));
+
+    const [deal] = await listDeals({ status: "active", now: NOW });
+
+    expect(deal).toEqual({
+      id: expect.any(String),
+      restaurantId: seed.restaurantId,
+      title: "Soon",
+      kind: "PERCENT_OFF",
+      percentOff: 10,
+      amountOffCents: null,
+      minOrderCents: 2000,
+      expiresAt: at(10).toISOString(),
+      source: "OFFICIAL",
+      status: "expiring_soon",
+    });
+  });
+});
+
+describe("GET /api/v1/deals", () => {
+  it("returns only non-hidden, non-expired deals, soonest expiry first, for ?status=active", async () => {
+    const seed = await seedBase();
+    await createDeal(seed, "Later", fromRealNow(200));
+    await createDeal(seed, "Soon", fromRealNow(10));
+    await createDeal(seed, "Expired", fromRealNow(-1));
+    await createDeal(seed, "Hidden", fromRealNow(5), { hidden: true });
+
+    const res = await GET(new Request("http://localhost/api/v1/deals?status=active"));
+
+    expect(res.status).toBe(200);
+    const body = (await res.json()) as { data: { title: string }[] };
+    expect(body.data.map((d) => d.title)).toEqual(["Soon", "Later"]);
+  });
+
+  it("answers 422 in the error envelope for an unknown status", async () => {
+    const res = await GET(new Request("http://localhost/api/v1/deals?status=bogus"));
+
+    expect(res.status).toBe(422);
+    const body = (await res.json()) as { error: { code: string } };
+    expect(body.error.code).toBe("VALIDATION_FAILED");
+  });
+});

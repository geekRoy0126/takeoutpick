+import "server-only";
+
+import { type DealKind, type DealSource, type DealStatus, getDealStatus } from "@/lib/domain/deals";
+import { db } from "@/lib/server/db";
+import type { ListDealsQuery } from "@/lib/validation/deal";
+
+export type DealDto = {
+  id: string;
+  restaurantId: string;
+  title: string;
+  kind: DealKind;
+  percentOff: number | null;
+  amountOffCents: number | null;
+  minOrderCents: number;
+  expiresAt: string;
+  source: DealSource;
+  status: DealStatus;
+};
+
+type ListDealsInput = ListDealsQuery & { now: Date };
+
+/** Non-hidden deals, soonest expiry first. Hidden deals are never returned (PRD §4). */
+export async function listDeals({ status, restaurantId, now }: ListDealsInput): Promise<DealDto[]> {
+  const expiresAt = status === "active" ? { gt: now } : status === "expired" ? { lte: now } : undefined;
+  const rows = await db.deal.findMany({
+    where: { hidden: false, restaurantId, expiresAt },
+    orderBy: [{ expiresAt: "asc" }, { id: "asc" }],
+    select: {
+      id: true,
+      restaurantId: true,
+      title: true,
+      kind: true,
+      percentOff: true,
+      amountOffCents: true,
+      minOrderCents: true,
+      expiresAt: true,
+      source: true,
+    },
+  });
+  return rows.map((row) => ({
+    ...row,
+    expiresAt: row.expiresAt.toISOString(),
+    status: getDealStatus(row.expiresAt, now),
+  }));
+}

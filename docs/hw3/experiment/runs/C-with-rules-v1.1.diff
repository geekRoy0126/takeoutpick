+import type { DealSource, DealStatus } from "@/lib/domain/deals";
+
+type DealBadgeProps = {
+  status: DealStatus;
+  source: DealSource;
+};
+
+const STATUS_LABEL: Record<DealStatus, string> = {
+  active: "Active",
+  expiring_soon: "Expiring soon",
+  expired: "Expired",
+};
+
+// Verified AA pairs only: text-surface on bg-deal-* (AGENTS.md §6.2).
+const STATUS_CLASS: Record<DealStatus, string> = {
+  active: "bg-deal-active",
+  expiring_soon: "bg-deal-soon",
+  expired: "bg-deal-expired",
+};
+
+const SOURCE_LABEL: Record<DealSource, string> = {
+  OFFICIAL: "Official",
+  COMMUNITY: "Community",
+};
+
+/** Status pill (color + word + icon) with the Official/Community tag beside it. */
+export function DealBadge({ status, source }: DealBadgeProps) {
+  const statusLabel = STATUS_LABEL[status];
+  const sourceLabel = SOURCE_LABEL[source];
+  return (
+    <span
+      role="group"
+      aria-label={`Deal status: ${statusLabel}, ${sourceLabel} deal`}
+      className="inline-flex items-center gap-2"
+    >
+      <span
+        className={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium text-surface ${STATUS_CLASS[status]}`}
+      >
+        <StatusIcon status={status} />
+        <span>{statusLabel}</span>
+      </span>
+      <span className="rounded-full border border-line bg-surface-muted px-2 py-0.5 text-xs font-medium text-ink-muted">
+        {sourceLabel}
+      </span>
+    </span>
+  );
+}
+
+// TODO(#5): switch to lucide-react (CheckCircle / Clock / XCircle) once it can be installed.
+function StatusIcon({ status }: { status: DealStatus }) {
+  const paths: Record<DealStatus, string> = {
+    active: "M5 12.5l4 4 10-10",
+    expiring_soon: "M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z",
+    expired: "M6 6l12 12M18 6L6 18",
+  };
+  return (
+    <svg
+      aria-hidden="true"
+      viewBox="0 0 24 24"
+      className="size-3.5"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2.5}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+    >
+      <path d={paths[status]} />
+    </svg>
+  );
+}

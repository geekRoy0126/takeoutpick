@@ -0,0 +1,16 @@
+// GET /api/v1/deals?status=active&restaurantId=... — public list of non-hidden deals (US3 #5).
+import { ok, parseOrThrow, toErrorResponse } from "@/lib/api/http";
+import { listDeals } from "@/lib/server/services/deal-service";
+import { listDealsQuerySchema } from "@/lib/validation/deal";
+
+export async function GET(request: Request): Promise<Response> {
+  try {
+    const params = Object.fromEntries(new URL(request.url).searchParams);
+    const query = parseOrThrow(listDealsQuerySchema, params);
+    // Read the clock once per request and pass it down (AGENTS.md §1.3).
+    const deals = await listDeals({ ...query, now: new Date() });
+    return ok(deals);
+  } catch (err) {
+    return toErrorResponse(err);
+  }
+}

@@ -0,0 +1,118 @@
+import { describe, expect, it } from "vitest";
+
+import { applyDeal, type DealTerms, getDealStatus } from "./deals";
+
+const NOW = new Date("2026-11-03T12:00:00Z");
+const HOUR_MS = 60 * 60 * 1000;
+const at = (hoursFromNow: number) => new Date(NOW.getTime() + hoursFromNow * HOUR_MS);
+
+const percent = (percentOff: number, minOrderCents = 0): DealTerms => ({
+  kind: "PERCENT_OFF",
+  percentOff,
+  amountOffCents: null,
+  minOrderCents,
+});
+const amount = (amountOffCents: number, minOrderCents = 0): DealTerms => ({
+  kind: "AMOUNT_OFF",
+  percentOff: null,
+  amountOffCents,
+  minOrderCents,
+});
+
+describe("getDealStatus", () => {
+  it("is 'active' when more than 72 hours remain", () => {
+    expect(getDealStatus(new Date(at(72).getTime() + 1), NOW)).toBe("active");
+    expect(getDealStatus(at(24 * 30), NOW)).toBe("active");
+  });
+
+  it("is 'expiring_soon' exactly 72 hours before expiry", () => {
+    expect(getDealStatus(at(72), NOW)).toBe("expiring_soon");
+  });
+
+  it("is 'expiring_soon' one millisecond before expiry", () => {
+    expect(getDealStatus(new Date(NOW.getTime() + 1), NOW)).toBe("expiring_soon");
+  });
+
+  it("is 'expired' exactly at expiry", () => {
+    expect(getDealStatus(NOW, NOW)).toBe("expired");
+  });
+
+  it("is 'expired' after expiry", () => {
+    expect(getDealStatus(at(-1), NOW)).toBe("expired");
+  });
+});
+
+describe("applyDeal", () => {
+  it("applies a percent-off deal with Math.round to the nearest cent", () => {
+    // 1999 × 15 / 100 = 299.85 → 300
+    expect(applyDeal(1999, percent(15), "active")).toEqual({
+      isApplied: true,
+      discountCents: 300,
+      afterCents: 1699,
+      shortfallCents: 0,
+    });
+  });
+
+  it("applies an amount-off deal", () => {
+    expect(applyDeal(2500, amount(500), "active")).toMatchObject({
+      isApplied: true,
+      discountCents: 500,
+      afterCents: 2000,
+    });
+  });
+
+  it("caps an amount-off larger than the subtotal at the subtotal", () => {
+    expect(applyDeal(800, amount(1000), "active")).toMatchObject({
+      isApplied: true,
+      discountCents: 800,
+      afterCents: 0,
+    });
+  });
+
+  it("gives no discount for 0% off", () => {
+    expect(applyDeal(1500, percent(0), "active")).toMatchObject({ discountCents: 0, afterCents: 1500 });
+  });
+
+  it("makes the price zero for 100% off", () => {
+    expect(applyDeal(1500, percent(100), "active")).toMatchObject({ discountCents: 1500, afterCents: 0 });
+  });
+
+  it("applies the deal when the subtotal exactly equals the minimum", () => {
+    expect(applyDeal(2000, amount(500, 2000), "active")).toMatchObject({
+      isApplied: true,
+      afterCents: 1500,
+      shortfallCents: 0,
+    });
+  });
+
+  it("does not apply the deal and reports $5.01 short when the subtotal is $14.99 and the minimum is $20", () => {
+    expect(applyDeal(1499, amount(500, 2000), "active")).toEqual({
+      isApplied: false,
+      discountCents: 0,
+      afterCents: 1499,
+      shortfallCents: 501,
+    });
+  });
+
+  it("applies an expiring-soon deal", () => {
+    expect(applyDeal(2000, percent(10), "expiring_soon")).toMatchObject({ isApplied: true, afterCents: 1800 });
+  });
+
+  it("never applies an expired deal and reports no shortfall", () => {
+    expect(applyDeal(1000, amount(500, 2000), "expired")).toEqual({
+      isApplied: false,
+      discountCents: 0,
+      afterCents: 1000,
+      shortfallCents: 0,
+    });
+  });
+
+  it("rejects non-integer cents", () => {
+    expect(() => applyDeal(10.5, percent(10), "active")).toThrow(TypeError);
+  });
+
+  it("treats a deal missing its value as no discount", () => {
+    expect(applyDeal(1000, { ...percent(10), percentOff: null }, "active")).toMatchObject({ discountCents: 0 });
+    expect(applyDeal(1000, { ...amount(100), amountOffCents: null }, "active")).toMatchObject({ discountCents: 0 });
+  });
+});
diff --git a/src/lib/domain/deals.ts b/src/lib/domain/deals.ts
new file mode 100644
index 0000000..26928df
--- /dev/null
+++ b/src/lib/domain/deals.ts
@@ -0,0 +1,56 @@
+// Deal status and discount rules (docs/PRD.md §4, US3 #5). Pure: `now` is always passed in.
+import { percentOf } from "./money";
+
+export const EXPIRING_SOON_HOURS = 72;
+const HOUR_MS = 60 * 60 * 1000;
+
+export type DealStatus = "active" | "expiring_soon" | "expired";
+export type DealKind = "PERCENT_OFF" | "AMOUNT_OFF";
+export type DealSource = "OFFICIAL" | "COMMUNITY";
+
+export type DealTerms = {
+  kind: DealKind;
+  percentOff: number | null;
+  amountOffCents: number | null;
+  minOrderCents: number;
+};
+
+export type AppliedDeal = {
+  isApplied: boolean;
+  discountCents: number;
+  afterCents: number;
+  /** Cents still missing to reach the minimum; 0 when applied or when the deal can never apply. */
+  shortfallCents: number;
+};
+
+/** Expired when now ≥ expiresAt; expiring soon when ≤ 72 h remain; active otherwise. */
+export function getDealStatus(expiresAt: Date, now: Date): DealStatus {
+  const remainingMs = expiresAt.getTime() - now.getTime();
+  if (remainingMs <= 0) return "expired";
+  if (remainingMs <= EXPIRING_SOON_HOURS * HOUR_MS) return "expiring_soon";
+  return "active";
+}
+
+/** Applies a deal to a subtotal. Expired deals are never applied; below the minimum there is no discount. */
+export function applyDeal(subtotalCents: number, deal: DealTerms, status: DealStatus): AppliedDeal {
+  const notApplied = (shortfallCents: number): AppliedDeal => ({
+    isApplied: false,
+    discountCents: 0,
+    afterCents: subtotalCents,
+    shortfallCents,
+  });
+  if (!Number.isInteger(subtotalCents)) {
+    throw new TypeError(`Expected integer cents, got ${subtotalCents}`);
+  }
+  if (status === "expired") return notApplied(0);
+  if (subtotalCents < deal.minOrderCents) return notApplied(deal.minOrderCents - subtotalCents);
+
+  const discountCents = discountFor(subtotalCents, deal);
+  return { isApplied: true, discountCents, afterCents: subtotalCents - discountCents, shortfallCents: 0 };
+}
+
+function discountFor(subtotalCents: number, deal: DealTerms): number {
+  if (deal.kind === "PERCENT_OFF") return percentOf(subtotalCents, deal.percentOff ?? 0);
+  // Amount-off never exceeds the subtotal (PRD §4.2).
+  return Math.min(deal.amountOffCents ?? 0, subtotalCents);
+}

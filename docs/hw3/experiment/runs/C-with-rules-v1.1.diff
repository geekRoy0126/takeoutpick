+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState } from "react";
+import { describe, expect, it } from "vitest";
+
+import type { DealTerms } from "@/lib/domain/deals";
+
+import { PriceWithDeal } from "./price-with-deal";
+
+const fiveOffOverTwenty: DealTerms = {
+  kind: "AMOUNT_OFF",
+  percentOff: null,
+  amountOffCents: 500,
+  minOrderCents: 2000,
+};
+
+describe("PriceWithDeal", () => {
+  it("shows the price before the deal struck through and the price after the deal", () => {
+    render(<PriceWithDeal subtotalCents={2500} deal={fiveOffOverTwenty} status="active" />);
+    expect(screen.getByText("$25.00").tagName).toBe("S");
+    expect(screen.getByText("$20.00")).toBeInTheDocument();
+    expect(screen.getByText("Price before deal")).toBeInTheDocument();
+    expect(screen.getByText("Price after deal")).toBeInTheDocument();
+  });
+
+  it("shows 'Add $5.01 more' when the subtotal is $14.99 and the minimum is $20", () => {
+    render(<PriceWithDeal subtotalCents={1499} deal={fiveOffOverTwenty} status="active" />);
+    expect(screen.getByRole("status")).toHaveTextContent("Add $5.01 more to use this deal");
+    expect(screen.getByText("$14.99").tagName).not.toBe("S");
+    expect(screen.queryByText("$9.99")).not.toBeInTheDocument();
+  });
+
+  it("applies the deal when the subtotal exactly equals the minimum", () => {
+    render(<PriceWithDeal subtotalCents={2000} deal={fiveOffOverTwenty} status="active" />);
+    expect(screen.getByText("$15.00")).toBeInTheDocument();
+    expect(screen.getByRole("status")).toBeEmptyDOMElement();
+  });
+
+  it("never applies an expired deal and shows no hint", () => {
+    render(<PriceWithDeal subtotalCents={2500} deal={fiveOffOverTwenty} status="expired" />);
+    expect(screen.getByText("$25.00").tagName).not.toBe("S");
+    expect(screen.queryByText("$20.00")).not.toBeInTheDocument();
+    expect(screen.queryByRole("status")).not.toBeInTheDocument();
+  });
+
+  it("shows the plain price when there is no deal", () => {
+    render(<PriceWithDeal subtotalCents={1250} deal={null} status={null} />);
+    expect(screen.getByText("$12.50")).toBeInTheDocument();
+    expect(screen.queryByRole("status")).not.toBeInTheDocument();
+  });
+
+  it("updates the hint live when the quantity changes", async () => {
+    const user = userEvent.setup();
+    function Harness() {
+      const [quantity, setQuantity] = useState(1);
+      return (
+        <>
+          <button type="button" onClick={() => setQuantity((q) => q + 1)}>
+            Add one
+          </button>
+          <PriceWithDeal subtotalCents={1499 * quantity} deal={fiveOffOverTwenty} status="active" />
+        </>
+      );
+    }
+    render(<Harness />);
+    expect(screen.getByRole("status")).toHaveTextContent("Add $5.01 more to use this deal");
+    await user.click(screen.getByRole("button", { name: "Add one" }));
+    expect(screen.getByRole("status")).toBeEmptyDOMElement();
+    expect(screen.getByText("$29.98").tagName).toBe("S");
+    expect(screen.getByText("$24.98")).toBeInTheDocument();
+  });
+});

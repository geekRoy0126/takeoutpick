+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import { DealBadge } from "./deal-badge";
+
+describe("DealBadge", () => {
+  it("shows 'Active' for an active deal", () => {
+    render(<DealBadge status="ACTIVE" source="OFFICIAL" />);
+    expect(screen.getByText("Active")).toBeInTheDocument();
+  });
+
+  it("shows 'Expiring soon' for a deal with 72 hours or less left", () => {
+    render(<DealBadge status="EXPIRING_SOON" source="OFFICIAL" />);
+    expect(screen.getByText("Expiring soon")).toBeInTheDocument();
+  });
+
+  it("shows 'Expired' for an expired deal", () => {
+    render(<DealBadge status="EXPIRED" source="OFFICIAL" />);
+    expect(screen.getByText("Expired")).toBeInTheDocument();
+  });
+
+  it("labels an official deal 'Official'", () => {
+    render(<DealBadge status="ACTIVE" source="OFFICIAL" />);
+    expect(screen.getByText("Official")).toBeInTheDocument();
+    expect(screen.queryByText("Community")).not.toBeInTheDocument();
+  });
+
+  it("labels a community deal 'Community'", () => {
+    render(<DealBadge status="ACTIVE" source="COMMUNITY" />);
+    expect(screen.getByText("Community")).toBeInTheDocument();
+    expect(screen.queryByText("Official")).not.toBeInTheDocument();
+  });
+});

+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import type { DealTerms } from "@/lib/domain/deals";
+
+import { PriceWithDeal } from "./price-with-deal";
+
+const NOW = new Date("2026-11-03T12:00:00Z");
+
+const fiveOffOverTwenty: DealTerms = {
+  kind: "AMOUNT_OFF",
+  percentOff: null,
+  amountOffCents: 500,
+  minOrderCents: 2000,
+  expiresAt: new Date("2026-11-10T12:00:00Z"),
+  hidden: false,
+};
+
+describe("PriceWithDeal", () => {
+  it("shows the price before the deal struck through and the price after", () => {
+    render(<PriceWithDeal subtotalCents={2500} deal={fiveOffOverTwenty} now={NOW} />);
+    const before = screen.getByText("$25.00");
+    expect(before.tagName).toBe("S");
+    expect(screen.getByText("$20.00")).toBeInTheDocument();
+  });
+
+  it("applies the deal when the subtotal exactly equals the minimum", () => {
+    render(<PriceWithDeal subtotalCents={2000} deal={fiveOffOverTwenty} now={NOW} />);
+    expect(screen.getByText("$20.00").tagName).toBe("S");
+    expect(screen.getByText("$15.00")).toBeInTheDocument();
+    expect(screen.getByRole("status")).toBeEmptyDOMElement();
+  });
+
+  it("shows 'Add $5.01 more' when the subtotal is $14.99 and the minimum is $20", () => {
+    render(<PriceWithDeal subtotalCents={1499} deal={fiveOffOverTwenty} now={NOW} />);
+    expect(screen.getByRole("status")).toHaveTextContent("Add $5.01 more to use this deal");
+    expect(screen.getByText("$14.99").tagName).not.toBe("S");
+    expect(screen.queryByText("$9.99")).not.toBeInTheDocument();
+  });
+
+  it("shows only the plain price for an expired deal", () => {
+    render(<PriceWithDeal subtotalCents={2500} deal={{ ...fiveOffOverTwenty, expiresAt: NOW }} now={NOW} />);
+    expect(screen.getByText("$25.00").tagName).not.toBe("S");
+    expect(screen.queryByText("$20.00")).not.toBeInTheDocument();
+    expect(screen.getByRole("status")).toBeEmptyDOMElement();
+  });
+
+  it("shows only the plain price when there is no deal", () => {
+    render(<PriceWithDeal subtotalCents={2500} now={NOW} />);
+    expect(screen.getByText("$25.00").tagName).not.toBe("S");
+    expect(screen.queryByRole("status")).not.toBeInTheDocument();
+  });
+});

+import { formatCents } from "@/lib/domain/money";
+
+type MinOrderHintProps = {
+  shortfallCents: number;
+};
+
+/** The live region stays mounted even when empty so screen readers announce the hint as it appears or changes. */
+export function MinOrderHint({ shortfallCents }: MinOrderHintProps) {
+  return (
+    <p role="status" aria-live="polite" className="text-sm text-deal-soon">
+      {shortfallCents > 0 ? `Add ${formatCents(shortfallCents)} more to use this deal` : null}
+    </p>
+  );
+}

+import type { DealSource, DealStatus } from "@/lib/domain/deals";
+
+const STATUS_DISPLAY: Record<DealStatus, { label: string; icon: string; className: string }> = {
+  ACTIVE: { label: "Active", icon: "✓", className: "bg-deal-active text-surface" },
+  EXPIRING_SOON: { label: "Expiring soon", icon: "!", className: "bg-deal-soon text-surface" },
+  EXPIRED: { label: "Expired", icon: "×", className: "bg-surface-muted text-deal-expired" },
+};
+
+const SOURCE_LABEL: Record<DealSource, string> = {
+  OFFICIAL: "Official",
+  COMMUNITY: "Community",
+};
+
+type DealBadgeProps = {
+  status: DealStatus;
+  source: DealSource;
+};
+
+/** Status pill (color plus word and icon, never color alone) with the deal's Official/Community tag. */
+export function DealBadge({ status, source }: DealBadgeProps) {
+  const display = STATUS_DISPLAY[status];
+  return (
+    <span className="inline-flex items-center gap-1.5 text-xs font-medium">
+      <span className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 ${display.className}`}>
+        <span aria-hidden="true">{display.icon}</span>
+        <span>{display.label}</span>
+      </span>
+      <span className="rounded-full border border-line px-2 py-0.5 text-ink-muted">{SOURCE_LABEL[source]}</span>
+    </span>
+  );
+}

# Copy to .env and fill in. Never commit .env. Production and preview values live in Vercel project settings.

# Postgres (local: docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takeoutpick"

# Auth: at least 32 random characters. Generate with: openssl rand -base64 32
JWT_SECRET=""

# Real-time Group Pick (Sprint 2, issue #9) — https://pusher.com Channels app keys
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us3"
